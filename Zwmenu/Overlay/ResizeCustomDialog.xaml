<Window x:Class="Zwmenu.Overlay.ResizeCustomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свой размер"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border CornerRadius="14" Padding="18,16"
            Background="#F0161618" BorderBrush="#44F5F0E8" BorderThickness="1">
        <StackPanel Width="220">
            <TextBlock Text="Свой размер" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FFF5F0E8" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WidthBox" Grid.Column="0" Height="34" FontSize="14"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         Background="#FF242428" Foreground="White" BorderBrush="#44F5F0E8"
                         CaretBrush="White" MaxLength="4"/>
                <TextBlock Grid.Column="1" Text="×" Foreground="#99F5F0E8"
                           VerticalAlignment="Center" Margin="8,0" FontSize="16"/>
                <TextBox x:Name="HeightBox" Grid.Column="2" Height="34" FontSize="14"
                         TextAlignment="Center" VerticalContentAlignment="Center"
                         Background="#FF242428" Foreground="White" BorderBrush="#44F5F0E8"
                         CaretBrush="White" MaxLength="4"/>
            </Grid>
            <TextBlock Text="Пиксели, кадр заполняется с обрезкой по центру"
                       FontSize="11" Foreground="#77F5F0E8" TextWrapping="Wrap" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Отмена" Height="34" Click="OnCancel"
                        Background="#22FFFFFF" Foreground="#EEF5F0E8" BorderBrush="#33F5F0E8"
                        BorderThickness="1" Cursor="Hand"/>
                <Button Grid.Column="2" Content="Готово" Height="34" Click="OnOk" IsDefault="True"
                        Background="#CC2A3E34" Foreground="White" BorderBrush="#66A8C5A0"
                        BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
