<Window x:Class="Zwmenu.Overlay.TextMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текст"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="560" Height="560"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Canvas x:Name="RingCanvas" Width="560" Height="560">
            <Path x:Name="MatteDonut" IsHitTestVisible="False" Opacity="0">
                <Path.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                         RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00000000" Offset="0.30"/>
                        <GradientStop Color="#B0121014" Offset="0.44"/>
                        <GradientStop Color="#C8181410" Offset="0.78"/>
                        <GradientStop Color="#90141010" Offset="1"/>
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <Ellipse x:Name="HoleRim" IsHitTestVisible="False" StrokeThickness="1.5" Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66E8D4A8" Offset="0"/>
                        <GradientStop Color="#22E8D4A8" Offset="0.5"/>
                        <GradientStop Color="#55D4B090" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Ellipse x:Name="OrbitRing" IsHitTestVisible="False" StrokeThickness="1.1" Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66E8D4A8" Offset="0"/>
                        <GradientStop Color="#18E8D4A8" Offset="0.45"/>
                        <GradientStop Color="#50D4B090" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Ellipse x:Name="ToolOrbitRing" IsHitTestVisible="False" StrokeThickness="1" Opacity="0"
                     Stroke="#38D4B090"/>

            <Border x:Name="StatusCard"
                    Padding="12,7"
                    CornerRadius="12"
                    Background="#F0121216"
                    BorderBrush="#40E8D4A8"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="StatusText"
                           FontSize="11.5"
                           LineHeight="16"
                           Foreground="#FFF5F0E8"
                           TextWrapping="Wrap"
                           MaxWidth="340"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
