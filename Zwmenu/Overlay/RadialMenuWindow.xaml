<Window x:Class="Zwmenu.Overlay.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zwmenu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="800" Height="700"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid>
        <Canvas x:Name="RingCanvas" Width="800" Height="700" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Мягкий край без BlurEffect: размытие на прозрачном окне рисуется процессором и вешает ввод. -->
            <Ellipse x:Name="SoftGlow" Width="400" Height="400" Canvas.Left="130" Canvas.Top="90" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#99000000" Offset="0.55"/>
                        <GradientStop Color="#44000000" Offset="0.8"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Матовый диск: размер/позиция синхронизируются в BuildButtons с орбитой кнопок -->
            <Ellipse x:Name="MatteDisc" Width="320" Height="320"
                     Canvas.Left="170" Canvas.Top="130" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                        <GradientStop Color="#F028282C" Offset="0"/>
                        <GradientStop Color="#E8222226" Offset="0.5"/>
                        <GradientStop Color="#D61A1A1E" Offset="0.85"/>
                        <GradientStop Color="#00101012" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- PNG-скин рамки: BitmapCache держит растр на GPU, без перекодирования на каждый кадр -->
            <Image x:Name="RingSkin" Width="380" Height="380"
                   Canvas.Left="140" Canvas.Top="100"
                   Stretch="Uniform" IsHitTestVisible="False"
                   Visibility="Collapsed" Opacity="0.98"
                   RenderOptions.BitmapScalingMode="Fant"
                   Panel.ZIndex="2">
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
                </Image.CacheMode>
            </Image>

            <Image x:Name="LookAura" Stretch="Uniform" IsHitTestVisible="False"
                   Visibility="Collapsed" Opacity="1"
                   RenderOptions.BitmapScalingMode="Fant" Panel.ZIndex="1">
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
                </Image.CacheMode>
            </Image>
            <Image x:Name="LookRing" Stretch="Uniform" IsHitTestVisible="False"
                   Visibility="Collapsed" Opacity="1"
                   RenderOptions.BitmapScalingMode="Fant" Panel.ZIndex="4">
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
                </Image.CacheMode>
            </Image>
            <Image x:Name="LookCore" Stretch="Uniform" IsHitTestVisible="False"
                   Visibility="Collapsed" Opacity="1"
                   RenderOptions.BitmapScalingMode="Fant" Panel.ZIndex="8">
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True"/>
                </Image.CacheMode>
            </Image>

            <!-- Орбита ровно под центрами слотов -->
            <Ellipse x:Name="OrbitRing" Width="232" Height="232" Canvas.Left="214" Canvas.Top="174"
                     StrokeThickness="1.5" IsHitTestVisible="False" Panel.ZIndex="3">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#55F5F0E8" Offset="0"/>
                        <GradientStop Color="#18F5F0E8" Offset="0.5"/>
                        <GradientStop Color="#40F5F0E8" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <!-- Подсказка позиционируется в коде: под flyout или под колесом -->
            <Border x:Name="HintCard"
                    Canvas.Left="0" Canvas.Top="0"
                    MinWidth="220" MaxWidth="360"
                    Padding="18,14"
                    CornerRadius="14"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    BorderThickness="1"
                    BorderBrush="#33F5F0E8"
                    Background="#F0161618"
                    Panel.ZIndex="60">
                <StackPanel>
                    <TextBlock x:Name="HintTitle"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#FFF5F0E8"/>
                    <TextBlock x:Name="HintBody"
                               Margin="0,5,0,0"
                               FontSize="12.5" LineHeight="17"
                               TextWrapping="Wrap"
                               Foreground="#B8F5F0E8"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
