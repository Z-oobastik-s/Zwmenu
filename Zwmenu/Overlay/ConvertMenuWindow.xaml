<Window x:Class="Zwmenu.Overlay.ConvertMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конвертация"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="600" Height="600"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Canvas x:Name="RingCanvas" Width="600" Height="600">
            <!-- Матовый пончик: кольцо видно, ярлык в дырке чистый -->
            <Path x:Name="MatteDonut" IsHitTestVisible="False" Opacity="0">
                <Path.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                         RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#00000000" Offset="0.28"/>
                        <GradientStop Color="#B0101014" Offset="0.42"/>
                        <GradientStop Color="#C8141418" Offset="0.72"/>
                        <GradientStop Color="#90101014" Offset="1"/>
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <Ellipse x:Name="HoleRim" IsHitTestVisible="False" StrokeThickness="1.5" Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66F5F0E8" Offset="0"/>
                        <GradientStop Color="#22F5F0E8" Offset="0.5"/>
                        <GradientStop Color="#55A8C5A0" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Ellipse x:Name="OrbitRing" IsHitTestVisible="False" StrokeThickness="1.1" Opacity="0">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66F5F0E8" Offset="0"/>
                        <GradientStop Color="#18F5F0E8" Offset="0.45"/>
                        <GradientStop Color="#50F5F0E8" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <TextBlock x:Name="HintText" Visibility="Collapsed" IsHitTestVisible="False"/>

            <Border x:Name="StatusCard"
                    Padding="12,7"
                    CornerRadius="12"
                    Background="#F0121216"
                    BorderBrush="#40F5F0E8"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="#FFF5F0E8"
                           TextWrapping="Wrap"
                           MaxWidth="260"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
