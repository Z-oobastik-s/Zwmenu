<Window x:Class="Zwmenu.Overlay.PathFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zwmenu"
        Width="480" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF141416"
        Foreground="#FFF5F0E8"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Padding="22" BorderBrush="#33F5F0E8" BorderThickness="1" Background="#FF18181A" CornerRadius="2">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ExplainText" Margin="0,10,0,0" FontSize="13.5" LineHeight="20"
                       Opacity="0.85" TextWrapping="Wrap"/>

            <TextBlock x:Name="PathLabel" Margin="0,14,0,4" FontSize="11.5" Opacity="0.5" Text="Старый путь"/>
            <Border x:Name="PathBox" Background="#FF101012" CornerRadius="8" Padding="12,10"
                    BorderBrush="#22F5F0E8" BorderThickness="1">
                <TextBlock x:Name="PathText" FontSize="12.5" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                           TextWrapping="Wrap" Opacity="0.9"/>
            </Border>

            <TextBlock x:Name="HintText" Margin="0,14,0,0" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                       Text="Укажи, куда программа или папка переехала: пункт на колесе обновится сразу."/>

            <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="#FFD4A19A" Visibility="Collapsed"/>

            <StackPanel x:Name="FixButtons" Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Right">
                <Button Content="Закрыть" Padding="14,8" Margin="0,0,8,0" Click="OnClose"
                        Background="#FF2A2A2E" Foreground="#FFF5F0E8" BorderBrush="#33F5F0E8" Cursor="Hand"/>
                <Button x:Name="BrowseFolderBtn" Content="Папка…" Padding="14,8" Margin="0,0,8,0" Click="OnBrowseFolder"
                        Background="#FF2A2A2E" Foreground="#FFF5F0E8" BorderBrush="#33F5F0E8" Cursor="Hand"/>
                <Button x:Name="BrowseFileBtn" Content="Указать новый путь…" Padding="16,8" Click="OnBrowseFile"
                        Background="#FF3E5E4A" Foreground="#FFF5F0E8" BorderBrush="#55A8C5A0" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel x:Name="DoneButtons" Orientation="Horizontal" Margin="0,18,0,0"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button Content="Готово" Padding="20,8" Click="OnClose"
                        Background="#FF3E5E4A" Foreground="#FFF5F0E8" BorderBrush="#55A8C5A0" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
