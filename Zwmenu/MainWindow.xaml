<Window x:Class="Zwmenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zwmenu"
        Height="420" Width="480"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FF141416"
        Foreground="#FFF0EDE8"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="MatteWash" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF17171A" Offset="0"/>
            <GradientStop Color="#FF1C1B19" Offset="0.55"/>
            <GradientStop Color="#FF141416" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Background="{StaticResource MatteWash}">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Zwmenu" FontSize="30" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock Grid.Row="2" Opacity="0.55" FontSize="13"
                       Text="Матовое колесо действий на рабочем столе"/>

            <TextBlock Grid.Row="4" TextWrapping="Wrap" LineHeight="20" Opacity="0.9" FontSize="13.5"
                       Text="Нажми среднюю кнопку мыши в любом месте: откроется колесо. Наведи на кнопку, чтобы увидеть, что она делает. Закрытие этого окна прячет программу в трей; хуки продолжают работать."/>

            <Border Grid.Row="6" Background="#FF1E1E20" CornerRadius="12" Padding="16,14"
                    BorderBrush="#22F0EDE8" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="20" Text="Запуск…"/>
                    <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5"
                               LineHeight="17" Foreground="#FFD4A19A" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Button x:Name="SettingsButton" Grid.Row="8" Content="Настроить колесо"
                    HorizontalAlignment="Left" Padding="16,8" Click="OnOpenSettings"
                    Background="#FF2A2A2E" Foreground="#FFF5F0E8" BorderBrush="#33F5F0E8"
                    Cursor="Hand"/>

            <TextBlock Grid.Row="8" Margin="168,8,0,0" VerticalAlignment="Center"
                       Opacity="0.45" FontSize="12"
                       Text="Трей → Выход, чтобы закрыть совсем."/>
        </Grid>
    </Grid>
</Window>
