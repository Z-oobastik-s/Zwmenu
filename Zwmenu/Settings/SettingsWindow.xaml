                                CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Значки" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,12" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"
                                           Text="Размер, подпись и форма карточки."/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Размер"/>
                                    <TextBlock x:Name="ShelfIconLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="64"/>
                                    <Slider x:Name="ShelfIconSlider" Minimum="32" Maximum="96" TickFrequency="2"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Просвет"/>
                                    <TextBlock x:Name="ShelfGapLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="8"/>
                                    <Slider x:Name="ShelfGapSlider" Minimum="0" Maximum="32" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Скругление"/>
                                    <TextBlock x:Name="ShelfRadiusLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="16"/>
                                    <Slider x:Name="ShelfRadiusSlider" Minimum="0" Maximum="36" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Подложка"/>
                                    <TextBlock x:Name="ShelfPlateLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="94"/>
                                    <Slider x:Name="ShelfPlateSlider" Minimum="15" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <CheckBox x:Name="ShelfNamesBox" Margin="0,10,0,0" Foreground="#FFF5F0E8" FontSize="13.5"
                                          Content="Показывать имена" Click="OnShelfClick"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Кегль имени"/>
                                    <TextBlock x:Name="ShelfNameSizeLabel" DockPanel.Dock="Right" Width="42" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="12"/>
                                    <Slider x:Name="ShelfNameSizeSlider" Minimum="9" Maximum="18" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF1A1A1E" BorderBrush="#22F5F0E8" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Место на экране" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,12" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"
                                           Text="Сколько рядов видно, какой ширины полоса и где она стоит."/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Ширина"/>
                                    <TextBlock x:Name="ShelfWidthLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="100%"/>
                                    <Slider x:Name="ShelfWidthSlider" Minimum="40" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="Рядов видно"/>
                                    <TextBlock x:Name="ShelfRowsLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="3"/>
                                    <Slider x:Name="ShelfRowsSlider" Minimum="1" Maximum="6" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="В ряду"/>
                                    <TextBlock x:Name="ShelfColumnsLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="авто"/>
                                    <Slider x:Name="ShelfColumnsSlider" Minimum="0" Maximum="24" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <TextBlock Margin="0,0,0,6" FontSize="13.5" Text="Выравнивание"/>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Button x:Name="ShelfAlignLeft" Tag="0" Content="Слева" Margin="0,0,4,0" Click="OnShelfAlign"/>
                                    <Button x:Name="ShelfAlignCenter" Tag="1" Content="Центр" Margin="2,0,2,0" Click="OnShelfAlign"/>
                                    <Button x:Name="ShelfAlignRight" Tag="2" Content="Справа" Margin="4,0,0,0" Click="OnShelfAlign"/>
                                </UniformGrid>
                                <CheckBox x:Name="ShelfBottomAuto" Foreground="#FFF5F0E8" FontSize="13.5"
                                          Content="Отступ снизу сам" Click="OnShelfClick"/>
                                <TextBlock Margin="22,2,0,6" Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                                           Text="Один ряд стоит выше, чтобы не закрывать низ обоев. Сними галку, если нужен свой отступ."/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="От низа"/>
                                    <TextBlock x:Name="ShelfBottomLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="0"/>
                                    <Slider x:Name="ShelfBottomSlider" Minimum="0" Maximum="200" TickFrequency="2"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF1A1A1E" BorderBrush="#22F5F0E8" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Если значков много" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,10" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"
                                           Text="Либо значки становятся меньше и всё видно сразу, либо полка листается."/>
                                <UniformGrid Columns="3">
                                    <Button x:Name="ShelfScrollFit" Tag="0" Content="Ужать" Margin="0,0,4,0" Click="OnShelfScroll"/>
                                    <Button x:Name="ShelfScrollX" Tag="1" Content="Вбок" Margin="2,0,2,0" Click="OnShelfScroll"/>
                                    <Button x:Name="ShelfScrollY" Tag="2" Content="Вниз" Margin="4,0,0,0" Click="OnShelfScroll"/>
                                </UniformGrid>
                                <TextBlock x:Name="ShelfScrollHint" Margin="0,8,0,0" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FF1A1A1E" BorderBrush="#22F5F0E8" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Отклик и поведение" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,2,0,12" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"
                                           Text="Наведение, игра и то, перекрывает ли полка окна."/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Width="132" VerticalAlignment="Center" FontSize="13.5" Text="При наведении"/>
                                    <TextBlock x:Name="ShelfHoverLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="13.5" Text="120%"/>
                                    <Slider x:Name="ShelfHoverSlider" Minimum="100" Maximum="160" TickFrequency="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnShelfSlider"/>
                                </DockPanel>
                                <CheckBox x:Name="ShelfPressBox" Margin="0,4,0,0" Foreground="#FFF5F0E8" FontSize="13.5"
                                          Content="Чуть вдавливать по нажатию" Click="OnShelfClick"/>
                                <CheckBox x:Name="ShelfHideGameBox" Margin="0,8,0,0" Foreground="#FFF5F0E8" FontSize="13.5"
                                          Content="Прятать, пока идёт игра" Click="OnShelfClick"/>
                                <CheckBox x:Name="ShelfAboveBox" Margin="0,8,0,0" Foreground="#FFF5F0E8" FontSize="13.5"
                                          Content="Поверх остальных окон" Click="OnShelfClick"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ShelfReset" Content="Вернуть вид как было" HorizontalAlignment="Left"
                                Padding="14,8" Click="OnShelfReset"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="#FF14120F" BorderBrush="#33F5F0E8" BorderThickness="1"
                        CornerRadius="14" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Образец" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,2,0,10" Opacity="0.55" FontSize="12.5" TextWrapping="Wrap"
                                   Text="Так карточки выглядят при текущих числах. Живая полка на рабочем столе меняется вместе с ними."/>
                        <Border Background="#FF1C1412" CornerRadius="10" ClipToBounds="True" Height="250">
                            <Viewbox Margin="12" Stretch="Uniform">
                                <WrapPanel x:Name="ShelfPreview" Orientation="Horizontal"/>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="ShelfPreviewNote" Margin="0,10,0,0" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FooterStatus" Opacity="0.75" FontSize="12.5" TextWrapping="Wrap"/>
                <TextBlock x:Name="ConfigPathText" Opacity="0.4" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="{Binding ConfigPath, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RevealFileButton" Content="Показать файл" Margin="0,0,8,0" Click="OnReveal"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
