<Window x:Class="Zwmenu.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:Zwmenu.Settings"
        Title="Zwmenu: настройки"
        Width="960" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="Manual"
        Background="#FF141416"
        Foreground="#FFF5F0E8"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <settings:ColorStringConverter x:Key="TintBrush"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1A1A1C"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF5F0E8"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3A3A40"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF5F0E8"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1A1A1E"/>
            <Setter Property="Foreground" Value="#FFF5F0E8"/>
            <Setter Property="BorderBrush" Value="#22F5F0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CaretBrush" Value="#FFF5F0E8"/>
            <Setter Property="SelectionBrush" Value="#FF3E5A6E"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="#FF1A1A1E"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66A8C5A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF5F0E8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2C2C32"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF34343C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF1A1A1E"/>
            <Setter Property="Foreground" Value="#FFF5F0E8"/>
            <Setter Property="BorderBrush" Value="#22F5F0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill"
                                                  HorizontalAlignment="Right" Margin="0,0,14,0"
                                                  Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="#B0F5F0E8" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF222228"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66A8C5A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{}{0}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FF1A1A1E"
                                        BorderBrush="#33F5F0E8"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Background="#FF1A1A1E"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2E"/>
            <Setter Property="Foreground" Value="#FFF5F0E8"/>
            <Setter Property="BorderBrush" Value="#33F5F0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF34343A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E3E44"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF3E5A6E"/>
            <Setter Property="BorderBrush" Value="#553E5A6E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A6A80"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF161618"/>
            <Setter Property="Foreground" Value="#FFF5F0E8"/>
            <Setter Property="BorderBrush" Value="#22F5F0E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer Focusable="False"
                                          Background="#FF161618"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF242428"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF323238"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock x:Name="PageHint" Margin="0,4,0,0" Opacity="0.65" FontSize="13" TextWrapping="Wrap"
                       Text="Пункты колеса. Первый — в центре, остальные сверху по часовой."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="NavWheel" Style="{StaticResource NavButton}" Content="Колесо" Click="OnNavWheel"/>
                <Button x:Name="NavBehavior" Style="{StaticResource NavButton}" Content="Поведение" Click="OnNavBehavior"/>
                <Button x:Name="NavShot" Style="{StaticResource NavButton}" Content="Скриншот" Click="OnNavShot"/>
                <Button x:Name="NavShelf" Style="{StaticResource NavButton}" Content="Полка" Click="OnNavShelf"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid x:Name="PageWheel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ItemSearchBox" TextChanged="OnItemSearchChanged"
                                 ToolTip="Название, путь, подсказка или пункт внутри группы"/>
                        <TextBlock x:Name="SearchWatermark" IsHitTestVisible="False"
                                   Margin="14,0,12,0" VerticalAlignment="Center"
                                   Opacity="0.4" FontSize="13"
                                   Text="Найти пункт"/>
                    </Grid>
                    <Button x:Name="SearchClear" Grid.Column="1" Content="Сбросить"
                            Margin="8,0,0,0" Padding="10,6" Visibility="Collapsed"
                            Click="OnSearchClear"/>
                </Grid>
                <TextBlock x:Name="SearchEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                           Margin="2,0,0,8" Opacity="0.7" FontSize="12.5" TextWrapping="Wrap"
                           Text="Ничего не нашлось."/>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,10,0,0">
                    <Button Content="Добавить" Margin="0,0,4,4" Click="OnAdd"/>
                    <Button Content="Копия" Margin="2,0,2,4" Click="OnDuplicate"/>
                    <Button Content="Удалить" Margin="4,0,0,4" Click="OnDelete"/>
                    <Button Content="Вверх" Margin="0,0,4,0" Click="OnMoveUp"/>
                    <Button Content="Вниз" Margin="2,0,2,0" Click="OnMoveDown"/>
                    <Button Content="Сброс" Margin="4,0,0,0" Click="OnReset"/>
                </UniformGrid>

                <ListBox x:Name="ItemList" Background="#FF161618" BorderBrush="#22F5F0E8"
                         BorderThickness="1" Padding="6"
                         SelectionChanged="OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16"
                                        Background="#FF28282C"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="#FFF8F4EE"/>
                                        <Image Width="20" Height="20" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFileIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Source" Value="{Binding IconPath}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Role}" Opacity="0.5" FontSize="11"/>
                                    <TextBlock Text="{Binding ExtraLabel}" FontSize="11" Foreground="#FFA8C5A0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExtraLabel}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Путь не задан или не найден" FontSize="11" Foreground="#FFD4A19A">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PathMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="2" Background="Transparent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Editor" IsEnabled="False">
                    <Border x:Name="ChildEditBanner" Margin="0,0,0,12" Padding="12,10" CornerRadius="10"
                            Background="#FF22282A" BorderBrush="#44A8C5A0" BorderThickness="1"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="← К группе" Padding="12,6"
                                    Click="OnBackToGroup" Cursor="Hand"
                                    Background="#FF2A2A2E" Foreground="#FFF5F0E8" BorderBrush="#33F5F0E8"/>
                            <TextBlock x:Name="ChildEditText" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontSize="12.5" Opacity="0.9"
                                       Text="Редактируешь пункт внутри группы. Список группы ниже: можно сразу добавить или удалить."/>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border x:Name="PreviewDisc" Width="64" Height="64" CornerRadius="32"
                                Background="#FF3A3A3E" BorderBrush="#55F5F0E8" BorderThickness="1"/>
                        <StackPanel Margin="14,6,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceText" FontSize="13" Opacity="0.7" Text="Место на колесе"/>
                            <TextBlock x:Name="PathState" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Название" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="LabelBox" TextChanged="OnFieldChanged"/>

                    <TextBlock Text="Заметка (на колесе не показывается)" Opacity="0.6" FontSize="12" Margin="0,12,0,4"/>
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="64" TextChanged="OnFieldChanged"/>

                    <TextBlock Text="Что делает пункт" Opacity="0.6" FontSize="12" Margin="0,12,0,4"/>
                    <ComboBox x:Name="KindBox" SelectedIndex="1" SelectionChanged="OnKindChanged">
                        <ComboBoxItem Content="Закрыть колесо"/>
                        <ComboBoxItem Content="Открыть папку, файл, программу или сайт"/>
                        <ComboBoxItem Content="Сочетание клавиш (Ctrl+W, Win+E…)"/>
                        <ComboBoxItem Content="Группа: при наведении выезжает ещё меню"/>
                    </ComboBox>

                    <StackPanel x:Name="LaunchFields" Margin="0,12,0,0">
                        <TextBlock x:Name="PathLabel" Text="Путь" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" TextChanged="OnFieldChanged"/>
                            <Button x:Name="BrowseFolderBtn" Grid.Column="1" Content="Папка…" Margin="8,0,0,0" Click="OnBrowseFolder"/>
                            <Button x:Name="BrowseFileBtn" Grid.Column="2" Content="Файл…" Margin="8,0,0,0" Click="OnBrowseFile"/>
                        </Grid>
                        <TextBlock x:Name="PathHint" Opacity="0.45" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Папка → проводник. .exe / .lnk → запуск. https://… → браузер. Можно путь с диска D."/>

                        <StackPanel x:Name="LaunchExtraFields">
                            <TextBlock Text="Аргументы запуска" Opacity="0.6" FontSize="12" Margin="0,12,0,4"/>
                            <TextBox x:Name="ArgsBox" TextChanged="OnFieldChanged"/>
                            <TextBlock Opacity="0.45" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Необязательно. Только для программ, например /windowed. Для папок не используется."/>

                            <CheckBox x:Name="RunAsAdminBox" Margin="0,14,0,0" Click="OnRunAsAdminClick"
                                      Foreground="#FFF5F0E8" FontSize="13">
                                <TextBlock TextWrapping="Wrap" LineHeight="18">
                                    <Run Text="Запускать от имени администратора"/>
                                    <LineBreak/>
                                    <Run FontSize="11.5" Foreground="#88F5F0E8"
                                         Text="Всегда спросит UAC. Для папок и приложений из Store не действует."/>
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ChildrenPanel">
                        <StackPanel x:Name="GroupLayoutPanel" Margin="0,16,0,0">
                            <TextBlock Text="Вид выезжающего меню" Opacity="0.6" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="GroupLayoutBox" SelectedIndex="0" SelectionChanged="OnGroupLayoutChanged">
                                <ComboBoxItem Content="Игры / программы: список"/>
                                <ComboBoxItem Content="Папки: сетка"/>
                                <ComboBoxItem Content="Процессы: убить кликом"/>
                            </ComboBox>
                            <TextBlock Opacity="0.45" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="«Процессы»: при наведении живой список, клик по иконке открывает диспетчер. Дочерние пункты не нужны."/>
                        </StackPanel>

                        <TextBlock Text="Пункты группы (добавляй и правь здесь)" Opacity="0.6" FontSize="12" Margin="0,14,0,4"/>
                        <TextBlock Opacity="0.45" FontSize="11.5" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="До 24 штук. Кликни строку: поля выше правят именно её. «Добавить» сразу создаёт новый пункт."/>
                        <ListBox x:Name="ChildList" MaxHeight="180" Background="#FF161618"
                                 BorderBrush="#22F5F0E8" BorderThickness="1"
                                 SelectionChanged="OnChildSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="22" Height="22" CornerRadius="4" Background="#FF28282C">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#FFF8F4EE"/>
                                                <Image Width="16" Height="16" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasFileIcon}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Source" Value="{Binding IconPath}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <Button Content="Добавить" Margin="0,0,4,0" Click="OnAddChild"/>
                            <Button Content="Удалить" Margin="2,0,2,0" Click="OnRemoveChild"/>
                            <Button Content="Выше" Margin="2,0,2,0" Click="OnChildUp"/>
                            <Button Content="Ниже" Margin="4,0,0,0" Click="OnChildDown"/>
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock Text="Значок" Opacity="0.6" FontSize="12" Margin="0,16,0,6"/>
                    <WrapPanel x:Name="IconHost"/>

                    <TextBlock Text="Цвет" Opacity="0.6" FontSize="12" Margin="0,14,0,6"/>
                    <WrapPanel x:Name="TintHost"/>

                    <Button Content="Проверить этот пункт" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Click="OnTest"/>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="PageBehavior" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BehNavRun" Style="{StaticResource NavButton}" Content="Запуск" Tag="run" Click="OnBehSection"/>
